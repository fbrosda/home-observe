      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Wärmepumpe Anforderung",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dfivenv2iqdc0d"
                      },
                      "spec": {
                        "dataset": "fb",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "select\n  time,\n  case\n    \n    when heatpump_operation_mode = 0 then 'keine Anforderung'\n    when (heatpump_info & -2) <> 0\n    and (\n      (heatpump_info & -2) & ((heatpump_info & -2) - 1)\n    ) <> 0 then 'Mehrere Anford.'\n    when heatpump_operation_mode = 1 then 'Heizen'\n    when heatpump_operation_mode = 2 then 'Kühlen'\n    when heatpump_operation_mode = 4 then 'Warmwasser'\n    when heatpump_operation_mode = 8 then 'Abtauen'\n    else 'unbekannt'\n  end \"Modus\",\n  case\n    when heatpump_operation_mode = 1 then case\n      when (heatpump_info & 2) = 2 then 'keine Anforderung'\n      when (heatpump_info & 4) = 4 then 'Externe Anforderung'\n      when (heatpump_info & 8) = 8 then 'Externe Anforderung'\n      when (heatpump_info & 16) = 16 then 'Systemkühlung'\n      when (heatpump_info & 32) = 32 then 'PV-Regelung'\n      when (heatpump_info & 64) = 64 then 'Frostschutzbetrieb'\n      when (heatpump_info & 128) = 128 then 'Anforderung HK A'\n      when (heatpump_info & 256) = 256 then 'Anforderung HK B'\n      when (heatpump_info & 512) = 512 then 'Anforderung HK C'\n      when (heatpump_info & 1024) = 1024 then 'Anforderung HK D'\n      when (heatpump_info & 2048) = 2048 then 'Anforderung HK E'\n      when (heatpump_info & 4096) = 4096 then 'Anforderung HK F'\n      when (heatpump_info & 8192) = 8192 then 'Anforderung HK G'\n      when (heatpump_info & 16384) = 16384 then 'System ausgeschaltet'\n      when (heatpump_info & 32768) = 32768 then 'iON controlled'\n      when (heatpump_info & 65536) = 65536 then 'Booster Anforderung'\n      else 'unbekannt'\n    end\n    when heatpump_operation_mode = 2 then case\n      when (heatpump_info & 2) = 2 then 'keine Anforderung'\n      when (heatpump_info & 4) = 4 then 'Externe Anforderung'\n      when (heatpump_info & 8) = 8 then 'Externe Anforderung'\n      when (heatpump_info & 16) = 16 then 'PV-Regelung'\n      when (heatpump_info & 128) = 128 then 'Anforderung HK A'\n      when (heatpump_info & 256) = 256 then 'Anforderung HK B'\n      when (heatpump_info & 512) = 512 then 'Anforderung HK C'\n      when (heatpump_info & 1024) = 1024 then 'Anforderung HK D'\n      when (heatpump_info & 2048) = 2048 then 'Anforderung HK E'\n      when (heatpump_info & 4096) = 4096 then 'Anforderung HK F'\n      when (heatpump_info & 8192) = 8192 then 'Anforderung HK G'\n      when (heatpump_info & 16384) = 16384 then 'System ausgeschaltet'\n      when (heatpump_info & 32768) = 32768 then 'iON controlled'\n      else 'unbekannt'\n    end\n    when heatpump_operation_mode = 4 then case\n      when (heatpump_info & 2) = 2 then 'Einmalige Ladung'\n      when (heatpump_info & 4) = 4 then 'Einmalige Boostladung'\n      when (heatpump_info & 8) = 8 then 'Externe Anforderung'\n      when (heatpump_info & 16) = 16 then 'Externe Anforderung'\n      when (heatpump_info & 32) = 32 then 'PV-Regelung'\n      when (heatpump_info & 64) = 64 then 'Systemkühlung'\n      when (heatpump_info & 128) = 128 then 'Zeitprogramm'\n      when (heatpump_info & 256) = 256 then 'Zeitprogramm (Boost)'\n      when (heatpump_info & 512) = 512 then 'System ausgeschaltet'\n      when (heatpump_info & 1024) = 1024 then 'Komfortladung'\n      when (heatpump_info & 2048) = 2048 then 'iON controlled'\n      when (heatpump_info & 4096) = 4096 then 'Anforderung Kaskade'\n      when (heatpump_info & 8192) = 8192 then 'Booster Anforderung'\n      else 'unbekannt'\n    end\n    when heatpump_operation_mode = 8 then 'Abtauen'\n    else ''\n  end as \"Anforderungsgrund\"\nfrom\n  (\n    select\n      time_bucket('$__interval', time) as time,\n      mode() WITHIN GROUP (\n        order by\n          heatpump_operation_mode\n      ) as heatpump_operation_mode,\n      mode() WITHIN GROUP (\n        order by\n          heatpump_info\n      ) as heatpump_info\n    from\n      idm\n    where\n      $__timeFilter(time)\n    group by\n      1\n  );",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
